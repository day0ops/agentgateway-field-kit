[0.000, "o", "\u001b[90m  Agentgateway Field Kit v0.1.0\u001b[39m\r\n\u001b[90m\u001b[39m\r\n"]
[0.000, "o", "\u001b[34m\u001b[34mℹ\u001b[39m\u001b[34m\u001b[39m Installing agentgateway...\r\n"]
[0.015, "o", "\u001b[?25l"]
[0.000, "o", "\u001b[32m?\u001b[39m \u001b[1mSelect installation profile:\u001b[22m\u001b[33m  (enter/space to select)\u001b[39m\r\n\u001b[36m❯\u001b[39m \u001b[36magentgateway-custom-config\u001b[39m\r\n\u001b[36m    - Agentgateway with custom configuration via ConfigMap and GatewayParameters\u001b[39m\r\n  agentgateway-custom-version\r\n    - Agentgateway with custom version, OCI registry, and controller extraEnv (e.g. Gateway API experimental)\r\n  agentgateway-standard\r\n    - Standard agentgateway profile (without additional addons)\r\n  agentgateway-with-keycloak\r\n    - Keycloak IdP for OBO token exchange, workload identity, and security demos\r\n  agentgateway-with-observability\r\n    - Agentgateway profile with full observability stack (Solo UI, Prometheus, Grafana, Loki, Tempo)\r\n  agentgateway-with-solo-ui\r\n    - Agentgateway profile with Solo UI and telemetry stack\r\n  eks-agentgateway-with-keycloak\r\n    - Keycloak and observability for EKS (gp3 storage, Route53 DNS, TLS via cert-manager)\r\n"]
[8.880, "o", "\u001b[15A\u001b[0J"]
[0.000, "o", "\u001b[32m?\u001b[39m \u001b[1mSelect installation profile:\u001b[22m\u001b[33m  (enter/space to select)\u001b[39m\r\n  agentgateway-custom-config\r\n    - Agentgateway with custom configuration via ConfigMap and GatewayParameters\r\n  agentgateway-custom-version\r\n    - Agentgateway with custom version, OCI registry, and controller extraEnv (e.g. Gateway API experimental)\r\n  agentgateway-standard\r\n    - Standard agentgateway profile (without additional addons)\r\n  agentgateway-with-keycloak\r\n    - Keycloak IdP for OBO token exchange, workload identity, and security demos\r\n  agentgateway-with-observability\r\n    - Agentgateway profile with full observability stack (Solo UI, Prometheus, Grafana, Loki, Tempo)\r\n  agentgateway-with-solo-ui\r\n    - Agentgateway profile with Solo UI and telemetry stack\r\n\u001b[36m❯\u001b[39m \u001b[36meks-agentgateway-with-keycloak\u001b[39m\r\n\u001b[36m    - Keycloak and observability for EKS (gp3 storage, Route53 DNS, TLS via cert-manager)\u001b[39m\r\n"]
